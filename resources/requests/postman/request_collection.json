      "name": "Customers",
      "item": [
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "let value = body;",
                  "try {",
                  "  const json = pm.response.json();",
                  "  value = typeof json === 'string' ? json : (json.id || json.customerId || body);",
                  "} catch (e) {}",
                  "pm.collectionVariables.set('customerId', value);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Member\",\n  \"dateOfBirth\": \"1987-08-12\",\n  \"email\": \"info@codeartify.com\"\n}"
            },
            "url": {
              "raw": "{{identityBaseUrl}}/customers",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          }
        },
        {
          "name": "Get customer",
